{
    "name": "modx-extras/mxheadless-dev",
    "description": "Development workspace for mxHeadless",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^1.11",
        "psr/http-message": "^1.1|^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-client": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "MxHeadless\\": "core/components/mxheadless/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MxHeadless\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "phpstan": "phpstan analyse -c phpstan.neon.dist --memory-limit=512M",
        "phpcs": "phpcs --standard=phpcs.xml.dist --warning-severity=0",
        "check-composer": "composer validate --strict",
        "check-audit": "composer audit",
        "ci": [
            "@check-composer",
            "@test",
            "@phpstan",
            "@phpcs",
            "@check-audit"
        ],
        "dump-autoload": "composer dump-autoload -d core/components/mxheadless"
    },
    "config": {
        "sort-packages": true
    }
}
